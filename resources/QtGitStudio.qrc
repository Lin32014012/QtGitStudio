<RCC>
    <qresource prefix="/icons">
        <file alias="QtGitStudio-16.png">icons/QtGitStudio-16.png</file>
        <file alias="QtGitStudio-24.png">icons/QtGitStudio-24.png</file>
        <file alias="QtGitStudio-32.png">icons/QtGitStudio-32.png</file>
        <file alias="QtGitStudio-48.png">icons/QtGitStudio-48.png</file>
        <file alias="QtGitStudio-64.png">icons/QtGitStudio-64.png</file>
        <file alias="QtGitStudio-128.png">icons/QtGitStudio-128.png</file>
        <file alias="QtGitStudio-256.png">icons/QtGitStudio-256.png</file>
        <file alias="open-repo.svg">icons/open-repo.svg</file>
        <file alias="init-repo.svg">icons/init-repo.svg</file>
        <file alias="clone-repo.svg">icons/clone-repo.svg</file>
        <file alias="repo.svg">icons/repo.svg</file>
        <file alias="file.svg">icons/file.svg</file>
        <file alias="back.svg">icons/back.svg</file>
    </qresource>
    <qresource prefix="/theme">
        <file alias="theme.qss">theme.qss</file>
    </qresource>
</RCC>
