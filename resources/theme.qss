/* v4-P6-26 global theme.
 *
 * Qt Style Sheets are a CSS subset: no box-shadow, no flex, and a plain
 * QWidget only paints a background when WA_StyledBackground is set (the
 * widgets that need it set that attribute in code). Hierarchy is therefore
 * expressed with borders + surface tints instead of shadows.
 *
 * Selector strategy: object names for one-off elements, dynamic properties
 * (`role`) for repeated primitives so C++ never repeats colors.
 */

/* ---------------- workspace roles (v4-P6-26) ---------------- */
QLabel[role="version"] {
    font-size: 14px;
    font-weight: 700;
    color: #171A1F;
}

QLabel[role="cardTitle"] {
    font-size: 14px;
    font-weight: 700;
    color: #171A1F;
}

QLabel[role="bodyText"] {
    font-size: 13px;
    color: #5B6472;
}

QLabel[role="bodyText"][state="ok"] {
    color: #047857;
    font-weight: 600;
}

QLabel[role="bodyText"][state="warn"] {
    color: #B45309;
    font-weight: 600;
}

QLabel[role="bodyText"][state="danger"] {
    color: #B91C1C;
    font-weight: 600;
}

QLabel[role="bodyText"][state="strong"] {
    font-size: 14px;
    font-weight: 700;
    color: #171A1F;
}

/* Suggestion banner: default is the informational tone. */
QLabel[role="hint"] {
    font-size: 13px;
    color: #1D4ED8;
    background: #EFF6FF;
    border: 1px solid #DBEAFE;
    border-radius: 8px;
    padding: 8px 10px;
}

QLabel[role="hint"][state="warn"] {
    color: #B45309;
    background: #FFFBEB;
    border-color: #FDE68A;
}

QLabel[role="hint"][state="ok"] {
    color: #047857;
    background: #ECFDF5;
    border-color: #D1FAE5;
}

QLabel[role="hint"][state="danger"] {
    color: #B91C1C;
    background: #FEF2F2;
    border-color: #FECACA;
}

QLabel[role="sectionHeading"] {
    font-size: 14px;
    font-weight: 700;
    color: #171A1F;
    background: #EFF6FF;
    border-left: 4px solid #2563EB;
    border-radius: 6px;
    padding: 5px 9px;
}

QPushButton[role="learn"] {
    background: #F0FDF4;
    color: #15803D;
    border: 1px solid #BBF7D0;
    font-weight: 600;
    padding: 9px 14px;
    font-size: 14px;
}

QPushButton[role="learn"]:hover {
    background: #DCFCE7;
    border-color: #86EFAC;
}

QPushButton[role="learn"]:pressed {
    background: #BBF7D0;
}

QPushButton[role="learn"]:disabled {
    background: #F3F4F6;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

/* File-status text inside the changes tree keeps semantic colours. */
QLabel[role="statusPill"] {
    font-size: 11px;
    border-radius: 7px;
    padding: 1px 7px;
}

/* ---------------- banners & boxes (v4-P6-26) ---------------- */
QFrame[role="bannerDanger"] {
    background: #FEF2F2;
    border: 1px solid #FCA5A5;
    border-radius: 8px;
}

QTextEdit[role="errorBox"], QPlainTextEdit[role="errorBox"] {
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 8px;
    padding: 8px;
    color: #92400E;
}

QLabel[role="pageTitle"] {
    font-size: 20px;
    font-weight: 700;
    color: #171A1F;
}

QToolButton[role="toolbar"] {
    background: #1F2937;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QToolButton[role="toolbar"]:hover {
    background: #374151;
}

QToolButton[role="toolbar"]:disabled {
    background: #9CA3AF;
}

QToolButton[role="toolbar"]::menu-indicator {
    image: none;
}

QPushButton[role="secondary"] {
    background: #F3F4F6;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[role="secondary"]:hover {
    background: #E5E7EB;
}

QPushButton[role="dangerOutline"] {
    background: #FEF2F2;
    color: #B91C1C;
    border: 1px solid #FCA5A5;
    border-radius: 6px;
    padding: 9px 14px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton[role="dangerOutline"]:hover {
    background: #FEE2E2;
    border-color: #F87171;
}

QPushButton[role="dangerOutline"]:pressed {
    background: #FECACA;
}

QPushButton[role="dangerOutline"]:disabled {
    background: #F3F4F6;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

QPushButton[role="primaryLarge"] {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton[role="primaryLarge"]:hover {
    background: #1D4ED8;
}

QPushButton[role="primaryLarge"]:pressed {
    background: #1E40AF;
}

QLabel[role="dropOverlay"] {
    background: rgba(255, 255, 255, 235);
    color: #171A1F;
    font-size: 18px;
    font-weight: 600;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}


/* ---------------- action-button variants (v4-P6-26) ----------------
 * ActionButtonFeedback tags configured buttons with a `variant`; these
 * rules own every colour, including the busy/success/error feedback
 * states. State rules come last so they beat :disabled (a busy button is
 * disabled while it reports progress).
 */
QPushButton[variant] {
    color: #FFFFFF;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    padding: 9px 14px;
}

QPushButton[variant="blue"] { background: #2563EB; }
QPushButton[variant="blue"]:hover { background: #1D4ED8; }
QPushButton[variant="blue"]:pressed { background: #1E40AF; }

QPushButton[variant="deep"] { background: #1D4ED8; }
QPushButton[variant="deep"]:hover { background: #1E40AF; }
QPushButton[variant="deep"]:pressed { background: #1E3A8A; }

QPushButton[variant="green"] { background: #16A34A; }
QPushButton[variant="green"]:hover { background: #15803D; }
QPushButton[variant="green"]:pressed { background: #166534; }

QPushButton[variant="red"] { background: #DC2626; }
QPushButton[variant="red"]:hover { background: #B91C1C; }
QPushButton[variant="red"]:pressed { background: #991B1B; }

QPushButton[variant="violet"] { background: #7C3AED; }
QPushButton[variant="violet"]:hover { background: #6D28D9; }
QPushButton[variant="violet"]:pressed { background: #5B21B6; }

QPushButton[variant="teal"] { background: #0F9F9A; }
QPushButton[variant="teal"]:hover { background: #0D8B87; }
QPushButton[variant="teal"]:pressed { background: #0B7471; }

QPushButton[variant="slate"] { background: #64748B; }
QPushButton[variant="slate"]:hover { background: #475569; }
QPushButton[variant="slate"]:pressed { background: #334155; }

QPushButton[variant]:disabled {
    background: #E5E7EB;
    color: #9CA3AF;
}

QPushButton[variant][busy="true"] {
    background: #475569;
    color: #FFFFFF;
}

QPushButton[variant][result="success"] {
    background: #16A34A;
    color: #FFFFFF;
}

QPushButton[variant][result="error"] {
    background: #DC2626;
    color: #FFFFFF;
}

QPushButton[variant]:focus {
    border-color: #2563EB;
    outline: none;
}

/* ---------------- panels, notes & diff views (v4-P6-26) ---------- */
QLabel[role="dangerTitle"] {
    font-size: 18px;
    font-weight: 700;
    color: #991B1B;
}

QLabel[role="panelLabel"] {
    font-weight: 700;
    color: #374151;
}

QLabel[role="accentLabel"] {
    font-weight: 700;
    color: #1D4ED8;
}

QLabel[role="okNote"] {
    color: #15803D;
    padding: 16px;
}

QLabel[role="monoBox"] {
    background: #FFFFFF;
    border: 1px solid #E7EAF0;
    border-radius: 8px;
    padding: 8px;
    color: #171A1F;
    font-family: Consolas, "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 12px;
}

QLabel[role="infoBox"] {
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 8px;
    padding: 8px;
    color: #1E40AF;
    font-size: 12px;
}

QTextEdit[role="diffView"], QPlainTextEdit[role="diffView"] {
    border: 1px solid #E7EAF0;
    border-radius: 8px;
    background: #F9FAFB;
    color: #171A1F;
    font-family: Consolas, "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 12px;
}

/* ---------------- small parts (v4-P6-26) ---------------- */
QLabel[role="dot"] {
    background: #CBD2DC;
    border: none;
    border-radius: 3px;
}

QLabel[role="dot"][state="ok"] {
    background: #10B981;
}

QLabel[role="dot"][state="idle"] {
    background: #CBD2DC;
}

QLabel[role="dot"][state="danger"] {
    background: #DC2626;
}

QFrame[role="iconTile"] {
    border: none;
    border-radius: 10px;
    background: #EFF4FF;
}

QFrame[role="iconTile"][tint="green"] {
    background: #F0FDF4;
}

QFrame[role="iconTile"][tint="violet"] {
    background: #F5F3FF;
}

QLabel[role="rowIcon"] {
    background: #FFFFFF;
    border: 1px solid #E1E6EF;
    border-radius: 7px;
}

QLabel[role="rowName"] {
    font-size: 12.5px;
    font-weight: 600;
    color: #171A1F;
    border: none;
    background: transparent;
}

QFrame[role="subtlePanel"] {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QLabel[role="validation"][state="ok"] {
    color: #15803D;
}

QLabel[role="validation"][state="danger"] {
    color: #B91C1C;
}

/* The welcome rail scrolls without chrome of its own. */
QScrollArea#projectScroll,
QScrollArea#projectScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#recentContainer {
    background: transparent;
    border: none;
}

QWidget#welcomeMain {
    background: #EEF0F4;
}

QScrollArea#welcomeMainScroll,
QScrollArea#welcomeMainScroll > QWidget > QWidget {
    background: #EEF0F4;
    border: none;
}

QFrame#guideStep {
    background: #F7F9FC;
    border: 1px solid #EEF1F6;
    border-radius: 9px;
}

QDialog {
    background: #FFFFFF;
}

/* ---------------- dialogs (v4-P6-26) ---------------- */
QLabel[role="dialogTitle"] {
    font-size: 16px;
    font-weight: 600;
}

QLabel[role="sectionTitle"] {
    font-size: 15px;
    font-weight: 600;
}

QLabel[role="statusText"] {
    font-weight: 600;
    color: #6B7280;
}

QLabel[role="statusText"][state="ok"] {
    color: #16A34A;
}

QLabel[role="statusText"][state="danger"] {
    color: #DC2626;
}

QLabel[role="statusText"][state="info"] {
    color: #2563EB;
}

QLabel[role="statusText"][state="plain"] {
    color: #374151;
}

QLabel[role="statusText"][state="idle"] {
    color: #6B7280;
}

QLabel[role="dangerBox"] {
    color: #7F1D1D;
    background: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 6px;
    padding: 10px;
}

QLabel[role="errorInline"] {
    color: #B91C1C;
    background: #FEF2F2;
    border-radius: 6px;
    padding: 8px;
}

QPushButton[role="softPrimary"] {
    background: #F8FAFC;
    color: #1E40AF;
    border: 1px solid #BFDBFE;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[role="softPrimary"]:hover {
    background: #EFF6FF;
}

QPushButton[role="softPrimary"]:pressed {
    background: #DBEAFE;
}

QPushButton[role="dark"] {
    background: #1F2937;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[role="dark"]:hover {
    background: #111827;
}

/* ---------------- base ---------------- */
QWidget {
    font-family: "Microsoft YaHei UI", "Noto Sans CJK SC", "Source Han Sans SC", "PingFang SC", sans-serif;
    font-size: 12px;
    color: #171A1F;
}

QMainWindow, QWidget#centralWidget {
    background: #EEF0F4;
}

QToolTip {
    background: #171A1F;
    color: #FFFFFF;
    border: none;
    padding: 4px 7px;
    border-radius: 6px;
}

/* ---------------- primitives ---------------- */
QFrame[role="card"] {
    background: #FFFFFF;
    border: 1px solid #E7EAF0;
    border-radius: 12px;
}

QFrame[role="panel"] {
    background: #FFFFFF;
    border: 1px solid #E7EAF0;
    border-radius: 10px;
}

QFrame[role="sidebar"] {
    background: #FAFBFD;
    border: none;
    border-right: 1px solid #E7EAF0;
}

QFrame[role="sidebarFoot"] {
    background: #F7F9FC;
    border: none;
    border-top: 1px solid #E7EAF0;
}

QFrame[role="strip"] {
    background: #FAFBFD;
    border: 1px solid #E7EAF0;
    border-radius: 10px;
}

QFrame[role="action"] {
    background: #FFFFFF;
    border: 1px solid #E4E8F0;
    border-radius: 12px;
}

QFrame[role="action"]:hover {
    background: #FCFDFF;
    border-color: #B9C6DE;
}

QFrame[role="row"] {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QFrame[role="row"]:hover {
    background: #F1F4FA;
}

QFrame[role="row"][selected="true"] {
    background: #EAF0FE;
}

QFrame[role="dashed"] {
    background: transparent;
    border: 1px dashed #D6DDE9;
    border-radius: 9px;
}

QFrame[role="dashed"]:hover {
    border-color: #B9C6DE;
    background: #F7FAFF;
}

/* ---------------- text roles ---------------- */
QLabel[role="hero"] {
    font-size: 23px;
    font-weight: 700;
    color: #171A1F;
}

QLabel[role="subtitle"] {
    font-size: 12.5px;
    color: #8A93A3;
}

QLabel[role="section"] {
    font-size: 10.5px;
    font-weight: 700;
    color: #8A93A3;
    letter-spacing: 1px;
}

QLabel[role="title"] {
    font-size: 13px;
    font-weight: 700;
    color: #171A1F;
}

QLabel[role="desc"] {
    font-size: 11.5px;
    color: #8A93A3;
}

QLabel[role="meta"] {
    font-size: 10.5px;
    color: #A6AEBB;
}

QLabel[role="mono"] {
    font-family: Consolas, "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 10.5px;
    color: #A6AEBB;
}

QLabel[role="link"] {
    font-size: 11.5px;
    color: #2563EB;
}

QLabel[role="body"] {
    font-size: 11.5px;
    color: #5B6472;
}

/* ---------------- pills ---------------- */
QLabel[role="pill"] {
    font-size: 10.5px;
    color: #5B6472;
    background: #FAFBFD;
    border: 1px solid #E4E8F0;
    border-radius: 9px;
    padding: 1px 8px;
}

QLabel[role="pillMono"] {
    font-family: Consolas, "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 10.5px;
    color: #5B6472;
    background: #FAFBFD;
    border: 1px solid #E4E8F0;
    border-radius: 9px;
    padding: 1px 8px;
}

QLabel[role="pillOk"] {
    font-size: 10.5px;
    color: #047857;
    background: #ECFDF5;
    border: 1px solid #D1FAE5;
    border-radius: 9px;
    padding: 1px 8px;
}

QLabel[role="pillWarn"] {
    font-size: 10.5px;
    color: #B45309;
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 9px;
    padding: 1px 8px;
}

/* ---------------- buttons ---------------- */
QPushButton {
    font-size: 11.5px;
    color: #3B4453;
    background: #FFFFFF;
    border: 1px solid #DFE4ED;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton:hover {
    border-color: #C3CBDA;
    background: #FCFDFF;
}

QPushButton:pressed {
    background: #F1F4FA;
}

QPushButton:disabled {
    color: #A6AEBB;
    border-color: #E9EDF3;
    background: #F7F9FC;
}

QPushButton[role="primary"] {
    color: #FFFFFF;
    background: #2563EB;
    border: 1px solid #2563EB;
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton[role="primary"]:disabled {
    color: #EBEFF7;
    background: #9DB8F0;
    border-color: #9DB8F0;
}

QPushButton[role="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    color: #5B6472;
}

QPushButton[role="ghost"]:hover {
    background: #F2F4F8;
    border-color: #E7EAF0;
    color: #171A1F;
}

QPushButton[role="ghost"]:checked {
    background: #EAF0FE;
    border-color: #BFDBFE;
    color: #1D4ED8;
}

QPushButton[role="danger"] {
    color: #B91C1C;
    background: #FEF2F2;
    border: 1px solid #FECACA;
}

/* ---------------- inputs ---------------- */
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox {
    background: #FFFFFF;
    border: 1px solid #E4E8F0;
    border-radius: 8px;
    padding: 6px 9px;
    selection-background-color: #C7D7FE;
    selection-color: #171A1F;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus {
    border-color: #2563EB;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

/* ---------------- tabs & trees ---------------- */
QTabWidget::pane {
    border: 1px solid #E7EAF0;
    border-radius: 10px;
    background: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #5B6472;
    border: none;
    padding: 7px 14px;
    margin-right: 2px;
    font-size: 12px;
}

QTabBar::tab:selected {
    color: #2563EB;
    border-bottom: 2px solid #2563EB;
}

QTabBar::tab:hover:!selected {
    color: #171A1F;
}

QTreeWidget, QTreeView, QListWidget, QListView, QTableView {
    background: #FFFFFF;
    border: 1px solid #E7EAF0;
    border-radius: 10px;
    outline: none;
}

QTreeWidget::item, QListWidget::item {
    padding: 4px 2px;
    border-radius: 6px;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background: #EAF0FE;
    color: #171A1F;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background: #F1F4FA;
}

QHeaderView::section {
    background: #FAFBFD;
    color: #5B6472;
    border: none;
    border-bottom: 1px solid #E7EAF0;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* ---------------- scrollbars ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #D8DEE8;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #C3CBDA;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #D8DEE8;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------------- misc ---------------- */
QSplitter::handle {
    background: #E7EAF0;
}

QMenu {
    background: #FFFFFF;
    border: 1px solid #E7EAF0;
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 22px 6px 14px;
    border-radius: 6px;
    font-size: 12px;
}

QMenu::item:selected {
    background: #EAF0FE;
    color: #171A1F;
}

QMenu::separator {
    height: 1px;
    background: #EEF1F6;
    margin: 4px 8px;
}

QProgressBar {
    background: #EFF2F7;
    border: none;
    border-radius: 5px;
    height: 8px;
    text-align: center;
    font-size: 10px;
}

QProgressBar::chunk {
    background: #2563EB;
    border-radius: 5px;
}
